{
  "telemetryPath": "./.continue/logs",
  
  "models": {
    "openai": {
      "apiKey": "${OPENAI_API_KEY}",
      "chatModel": "gpt-4o-mini",
      "completionModel": "gpt-4o-mini",
      "temperature": 0.2,
      "maxTokens": 4000,
      "requestTimeout": 60000
    }
  },

  "agents": {
    "writer": {
      "name": "Code Generator",
      "model": "openai",
      "systemMessage": "file://./.continue/prompts/writer_system.md",
      "temperature": 0.3
    },
    "reviewer": {
      "name": "Code Reviewer",
      "model": "openai",
      "systemMessage": "file://./.continue/prompts/reviewer_system.md",
      "temperature": 0.2
    },
    "security_scanner": {
      "name": "Security Scanner",
      "model": "openai",
      "systemMessage": "file://./.continue/prompts/security_system.md",
      "temperature": 0.0
    },
    "fixer": {
      "name": "Auto Fixer",
      "model": "openai",
      "systemMessage": "file://./.continue/prompts/fixer_system.md",
      "temperature": 0.1,
      "maxRetries": 2
    }
  },

  "chains": {
    "production_cycle": {
      "displayName": "🤖 Production Cycle",
      "maxSteps": 8,
      "steps": [
        {
          "type": "input",
          "name": "task_prompt",
          "message": "📝 Опишите задачу для кода:",
          "required": true
        },
        {
          "agent": "writer",
          "name": "Code Generation",
          "input": "{{task_prompt}}",
          "saveOutput": ".continue/logs/generated_code.json"
        },
        {
          "agent": "security_scanner",
          "name": "Security Check",
          "input": "{{generated_code}}",
          "failOnCritical": true,
          "saveOutput": ".continue/logs/security_report.json"
        },
        {
          "agent": "reviewer",
          "name": "Quality Review",
          "input": "{{generated_code}}\n\nSecurity Issues: {{security_report}}",
          "minScoreRequired": 7.0
        },
        {
          "type": "user_intervention",
          "message": "📋 КОД ГОТОВ К РЕВЬЮ\n\n{{generated_code}}\n\nВведите 'approve' для создания PR:",
          "allowedInputs": ["approve", "reject"],
          "timeout": 3600
        }
      ]
    }
  },

  "contextProviders": {
    "git": {
      "enabled": true,
      "maxDiffLines": 500
    },
    "codebase": {
      "enabled": true,
      "ignorePatterns": ["node_modules", ".git", "dist"]
    }
  },

  "safety": {
    "maxCostPerDay": 10.0,
    "requireApprovalForPublish": true
  },

  "logging": {
    "level": "info",
    "format": "jsonl",
    "outputs": [
      {
        "type": "file",
        "path": ".continue/logs/events.jsonl"
      }
    ]
  }
}